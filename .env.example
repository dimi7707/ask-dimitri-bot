# Copy to .env for local development: `cp .env.example .env`
# Values below target the local stack (docker compose): Postgres+pgvector and LocalStack S3.

# --- Bedrock (no local emulation: these call real AWS with low-cost models) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Ceiling on a single Bedrock call, applied to every client the providers build. Sized for Lambda:
# 2 attempts x (3s connect + 8s read) is ~22s worst case, inside the function's 30s timeout. The
# trade is retries — botocore's own default is 5 attempts, which cannot fit inside 30s.
BEDROCK_CONNECT_TIMEOUT=3
BEDROCK_READ_TIMEOUT=8
BEDROCK_MAX_ATTEMPTS=2

# --- RAG tuning ---
SIMILARITY_THRESHOLD=0.6
SIMILARITY_TOP_K=5
INCLUDE_DEBUG_CONTEXT=true
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Provider selectors ---
STORAGE_PROVIDER=s3
EMBEDDING_PROVIDER=bedrock
LLM_PROVIDER=bedrock
VECTOR_STORE_PROVIDER=pgvector
DOCUMENT_PROCESSOR=llamaindex

# --- Vector store ---
# Ports match the docker/docker-compose.yml host mappings (non-standard to avoid collisions).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/askdimitri
# Pool sizing. The defaults below match Lambda (one request per container at a time); a runtime
# that serves requests concurrently in one process should raise them, otherwise requests queue
# behind pool_timeout instead of running.
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=2

# --- Object storage (LocalStack locally; leave S3_ENDPOINT_URL empty for real AWS) ---
S3_BUCKET_NAME=askdimitri-documents
S3_ENDPOINT_URL=http://localhost:45660
